# ─────────────────────────────────────────────────────────────────────────────
# OnCall — example environment file.
#
#   cp .env.example .env       # phir .env mein asli key daalo
#
# 🔴 `.env` gitignored hai (.gitignore "Secrets" block). `.env.example` NAHI hai
#    — wo commit hoti hai, taaki koi bhi jaan sake kaunse variables chahiye.
#    Isliye yahan koi asli secret nahi jaata. Placeholder hi jaate hain.
# ─────────────────────────────────────────────────────────────────────────────

# ── Control plane DB (oncall-db) ───────────────────────────────────────────────
# Ye OnCall ka apna database hai — incidents, events, llm_calls, runbooks.
# Monitored stack ke shopdb se ALAG hai, jaan-boojh kar (DECISIONS.md D9):
# agar shopdb toot jaaye (jo F2/F3/F4 mein hota hai), evidence bachi rehni chahiye.
ONCALL_DB_URL=postgresql://oncall:oncall@127.0.0.1:5433/oncall

# ── Monitored stack ka DB (shopdb) ────────────────────────────────────────────
# Ye connection sirf chaos injection aur seeding ke liye hai. Agent ka
# business logic ise nahi chhoota.
SHOPDB_URL=postgresql://shop:shop@127.0.0.1:5432/shop

# ── Monitored service ka base URL ─────────────────────────────────────────────
# Health oracle isi pe probe maarta hai.
SHOPAPP_URL=http://127.0.0.1:8001

# ── LLM providers (Phase 5) ───────────────────────────────────────────────────
# Groq primary hai: ✅ verified 2026-08-21 — 200K tokens/day, 8K TPM, 1000 RPD.
# 🔴 PLACEHOLDER — asli key SIRF .env mein (gitignored). 2026-08-24 pe ek asli
#    key yahan leak ho gayi thi; rotate ki gayi aur placeholder laga diya gaya.
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ⚠️ Fallback providers — ToS aur free-tier limits UNVERIFIED (RISKS.md R9).
# Khaali chhodo jab tak verify na ho.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Fallback models (router inhe OpenAI-compatible endpoints pe use karta hai).
# 🔴 SIRF TAB active jab neeche ONCALL_PIN_PROVIDER khaali ho.
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── KITNI KEYS CHAHIYE (imaandaari se) ────────────────────────────────────────
#   Groq       : SIRF EK account. Doosra banana = ToS violation (D18 — ye
#                apne aap mein banned hai, chahe "backup" ke liye kyun na ho).
#   Resilience : Gemini + OpenRouter ki ek-ek free key daalo, phir neeche wali
#                pin ko KHAALI chhod do → router chain chalata hai:
#                Groq -> Gemini -> OpenRouter (429 pe backoff 2/4/8s).
#   Measurement: eval runs mein pin HAMESHA 'groq' rehta hai (R8 — warna N3
#                delta me provider ka farq ghul-mil jaata hai).

# Measurement runs mein provider PIN karna zaruri hai, warna metrics confound
# ho jaate hain (RISKS.md R8). Ablation ke waqt ye `groq` pe set hoti hai.
# 🔴 Khaali ('') = fallback chain ENABLE.
ONCALL_PIN_PROVIDER=groq

# ── Retrieval (Phase 6) ───────────────────────────────────────────────────────
# Embedding service alag process hai taaki torch worker ke andar na aaye.
ONCALL_EMBED_URL=http://127.0.0.1:8010

# 🔴 top_k = 3, aur ye ek soch-kar liya gaya number hai, default nahi:
# 8K TPM budget pe 3 runbooks se zyada prompt mein nahi jaa sakte
# (TOKEN_BUDGET.md §2).
ONCALL_TOP_K=3

# ── Ablation switch (Phase 8) ────────────────────────────────────────────────
# `false` karne pe retrieval poori tarah skip hoti hai. Ye N3 metric ka
# poora mechanism hai — ek boolean, ek GROUP BY.
ONCALL_RAG_ENABLED=true

# ── Reproducibility ───────────────────────────────────────────────────────────
# Fault injection ka RNG seed. Same seed = same fault sequence.
ONCALL_SEED=1337

# 🔴 Listen address DELIBERATELY yahan nahi hai.
#    Wo code mein hardcoded 127.0.0.1 hai (oncall/config.py) kyunki Docker
#    socket root-equivalent hai — usko ek env var se 0.0.0.0 karna ek typo
#    ki doori pe network-exposed root ban jaata (THREAT_MODEL.md §7).
